# Server-only key used by the Gemini video transcription endpoint.
# Never prefix this key with VITE_ or expose it to browser code.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional: override the connected S3 presign service.
S3_PRESIGN_API_BASE=https://4twap62wo2.execute-api.ap-northeast-2.amazonaws.com
VITE_S3_PRESIGN_API_BASE=https://4twap62wo2.execute-api.ap-northeast-2.amazonaws.com

# Optional Firebase web config overrides. The original review project's public
# Firebase web config is included as the default in src/utils/firebaseConfig.ts.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
